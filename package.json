{
  "name": "pdf",
  "displayName": "PDF Viewer & Editor",
  "description": "Read, highlight, comment on and draw over PDFs in VS Code, Acrobat-compatible",
  "version": "0.0.3",
  "publisher": "mantasu",
  "icon": "resources/media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/mantasu/pdf"
  },
  "license": "MIT",
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "keywords": [
    "pdf",
    "portable document format",
    "viewer",
    "editor",
    "annotate",
    "highlight",
    "mark",
    "comment",
    "resolve",
    "sticky note",
    "draw",
    "drawing",
    "research",
    "paper",
    "summarize",
    "explain",
    "ask",
    "copilot",
    "form",
    "sign",
    "fill",
    "latex",
    "maths"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "scripts": {
    "postinstall": "node scripts/pdfjs.mjs",
    "compile": "node -e \"require('fs').rmSync('out',{recursive:true,force:true})\" && tsc -p ./",
    "bundle": "esbuild src/extension.ts --bundle --minify --platform=node --format=cjs --target=node20 --external:vscode --outfile=out/extension.js",
    "vscode:prepublish": "npm run compile && node scripts/pdfjs.mjs && npm run bundle",
    "test": "vitest run --coverage",
    "test:e2e": "npm run compile && node test/e2e/run.cjs",
    "package": "npx @vscode/vsce package",
    "release": "semantic-release"
  },
  "contributes": {
    "configuration": {
      "title": "PDF Viewer & Editor",
      "properties": {
        "pdf.defaultZoomValue": {
          "type": "string",
          "default": "auto",
          "scope": "resource",
          "enum": [
            "auto",
            "page-actual",
            "page-fit",
            "page-width",
            "50",
            "75",
            "100",
            "125",
            "150",
            "200"
          ],
          "description": "Default zoom level when opening a PDF."
        },
        "pdf.sidebarViewOnLoad": {
          "type": "number",
          "default": 0,
          "scope": "resource",
          "enum": [
            -1,
            0,
            1,
            2
          ],
          "enumDescriptions": [
            "Restore previous state",
            "None",
            "Thumbnails",
            "Outline"
          ],
          "description": "pdf.js side panel to show when opening a PDF."
        },
        "pdf.presetColors": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[^=]+=#[0-9a-fA-F]{6}$"
          },
          "default": [
            "Yellow=#FFD60A",
            "Red=#FF453A",
            "Purple=#AF52DE",
            "Green=#30D158",
            "Blue=#409CFF"
          ],
          "maxItems": 5,
          "scope": "resource",
          "markdownDescription": "Preset colors as `Name=#RRGGBB` (up to five), shared by every tool; text and Fill & Sign marks use black and darker shades of them. Any other color can be picked with the custom color button."
        },
        "pdf.authorName": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "markdownDescription": "Author name on new comments and drawings (`/T`). Defaults to your operating-system user name."
        },
        "pdf.copilot.model": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "markdownDescription": "Language model for the viewer's **Ask Copilot** actions: a model id or name as listed by **PDF: Choose Copilot Model…**, e.g. a Claude, GPT or Gemini model from Copilot, or one added with your own API key. Empty picks a Copilot model. `@pdf` in the chat uses the model chosen there."
        },
        "pdf.printCommand": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "markdownDescription": "Shell command used for printing. The PDF is written to a temp file and its path is passed as the sole argument, e.g. `lpr` or `lp -d myprinter`. When empty, the PDF is opened with the OS default handler."
        }
      }
    },
    "customEditors": [
      {
        "viewType": "pdf.viewer",
        "displayName": "PDF Viewer & Editor",
        "selector": [
          {
            "filenamePattern": "*.pdf"
          }
        ],
        "priority": "default"
      }
    ],
    "commands": [
      {
        "command": "pdf.rotatePage",
        "title": "Rotate Page",
        "category": "PDF"
      },
      {
        "command": "pdf.deletePage",
        "title": "Delete Current Page",
        "category": "PDF"
      },
      {
        "command": "pdf.movePageUp",
        "title": "Move Current Page Up",
        "category": "PDF"
      },
      {
        "command": "pdf.movePageDown",
        "title": "Move Current Page Down",
        "category": "PDF"
      },
      {
        "command": "pdf.insertBlankPageBefore",
        "title": "Insert Blank Page Before",
        "category": "PDF"
      },
      {
        "command": "pdf.insertBlankPageAfter",
        "title": "Insert Blank Page After",
        "category": "PDF"
      },
      {
        "command": "pdf.print",
        "title": "Print Current PDF",
        "category": "PDF"
      },
      {
        "command": "pdf.chooseCopilotModel",
        "title": "Choose Copilot Model…",
        "category": "PDF"
      }
    ],
    "chatParticipants": [
      {
        "id": "pdf.assistant",
        "name": "pdf",
        "fullName": "PDF Viewer & Editor",
        "description": "Ask about the open PDF (its text, your selection and the comments)",
        "isSticky": true,
        "commands": [
          {
            "name": "summarize",
            "description": "Summarize the document"
          },
          {
            "name": "explain",
            "description": "Explain the passage selected in the PDF"
          },
          {
            "name": "comments",
            "description": "Go through the comments and replies"
          }
        ]
      }
    ]
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "mathjax-full": "^3.2.2",
    "pdf-lib": "^1.17.1"
  },
  "devDependencies": {
    "@semantic-release/changelog": "*",
    "@semantic-release/commit-analyzer": "*",
    "@semantic-release/git": "*",
    "@semantic-release/github": "*",
    "@semantic-release/npm": "*",
    "@semantic-release/release-notes-generator": "*",
    "@types/node": "*",
    "@types/vscode": "~1.95.0",
    "@vitest/coverage-v8": "*",
    "esbuild": "^0.28.2",
    "gifenc": "^1.0.3",
    "omggif": "^1.0.10",
    "playwright-core": "^1.63.0",
    "pngjs": "^7.0.0",
    "semantic-release": "*",
    "semantic-release-vsce": "*",
    "typescript": "*",
    "vitest": "*"
  }
}
